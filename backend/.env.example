# LLM (OpenAI-compatible) — project .env overrides system OPENAI_API_KEY
OPENAI_API_KEY=your-deepseek-or-openai-key
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Vision Agent — read Xiaohongshu outfit PHOTOS (multimodal) before planning.
# 百炼识图：OpenAI 兼容 Chat Completions + Qwen-VL，见
# https://help.aliyun.com/zh/model-studio/qwen-vl-compatible-with-openai
VISION_USE_IMAGES=true
# 视觉模型（勿用 deepseek-v4-pro，它是纯文本）
VISION_MODEL=qwen3-vl-plus
# 百炼 API Key（可与下方 DASHSCOPE_API_KEY 填同一个 sk- 密钥）
VISION_API_KEY=
# 华北2（北京）地域；新加坡用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MAX_IMAGES_PER_NOTE=2
# 规则编译后是否用 LLM 扩展 1-2 条备选小红书搜索词（Outfit Query Compiler Step 3）
XHS_QUERY_LLM_EXPAND=false

# Product search: onebound | justoneapi | scraper | mock
PRODUCT_SOURCE=mock
# PRODUCT_FALLBACK_SCRAPER=false

# OneBound Taobao API (when PRODUCT_SOURCE=onebound)
ONEBOUND_KEY=your-onebound-key
ONEBOUND_SECRET=your-onebound-secret

# Just One API — Taobao search (when PRODUCT_SOURCE=justoneapi)
# Docs: https://docs.justoneapi.com/zh/api/taobao-and-tmall/product-search-v1
JUSTONEAPI_TOKEN=your-justoneapi-token
# 默认国际节点；大陆可选: http://47.117.133.51:30015
JUSTONEAPI_BASE_URL=https://api.justoneapi.com
# _sale=销量(推荐); bid=价格升序在 Just One 上常返回空列表
JUSTONEAPI_SORT=_sale
JUSTONEAPI_MAX_CALLS_PER_RUN=8
# 小红书穿搭参考（笔记搜索 V3 + 详情 V2 → Vision 分析 → 即梦 i2i）
JUSTONEAPI_XHS_NOTES_PER_DAY=3
JUSTONEAPI_XHS_MAX_CALLS_PER_RUN=15
JUSTONEAPI_XHS_FETCH_DETAIL=true
# 0 = 不过滤；可设为 500 只保留高赞笔记
JUSTONEAPI_XHS_MIN_LIKED=0

# Scraper (when PRODUCT_SOURCE=scraper) — often blocked by Taobao; min seconds between requests
# SCRAPER_MIN_INTERVAL_SEC=2

# AMap (Gaode) Web Service — geocoding + weather
AMAP_API_KEY=your-amap-web-service-key

# Image generation — Jimeng (Volcengine, recommended)
# Set SKIP_IMAGE_GENERATION=true to skip API calls during testing
SKIP_IMAGE_GENERATION=true
IMAGE_PROVIDER=jimeng
VOLCENGINE_ACCESS_KEY=your-volcengine-access-key
VOLCENGINE_SECRET_KEY=your-volcengine-secret-key
JIMENG_REQ_KEY=jimeng_t2i_v31
JIMENG_I2I_REQ_KEY=jimeng_i2i_v30
JIMENG_IMAGE_WIDTH=1328
JIMENG_IMAGE_HEIGHT=1328
# 用小红书笔记穿搭图作即梦 i2i 参考，换景点背景；AI 失败则直接用参考图
IMAGE_USE_XHS_REFERENCE=false
IMAGE_REFERENCE_FALLBACK_DIRECT=false

# Image generation — DashScope fallback (optional)
DASHSCOPE_API_KEY=
IMAGE_MODEL=wan2.2-t2i-flash

# Optional
ONEBOUND_MAX_CALLS_PER_RUN=8
CACHE_DIR=.cache

# API request/response recording — for debugging and future mock replay
API_RECORD_ENABLED=true
API_RECORD_DIR=.cache/api-recordings

# Vue frontend (see frontend/.env.example)
# Run API: uv sync --extra api && uv run uvicorn api.main:app --reload --port 8000
# Run UI:  cd ../frontend && npm run dev  → http://localhost:5173 (proxies /api)
